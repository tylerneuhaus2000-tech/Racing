{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": ".",
    "predeploy": [
      "npm run audit:gt3"
    ],
    "rewrites": [
      {
        "source": "/api/rewarded-video",
        "function": "rewardedVideoGrant"
      }
    ],
    "ignore": [
      "firebase.json",
      ".git/**",
      ".firebase/**",
      "firebase-debug.log",
      "ai-bench.js",
      "usage-dashboard.js",
      "**/.*",
      "**/node_modules/**",
      "tools/**",
      "dist/**",
      "functions/**"
    ]
  }
}
