rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && (
        request.auth.uid == 'qg9FDw4TZWhxX7en6JHuOI6GqZt2' ||
        request.auth.uid == '25Mc4Wuwp4YxFFwNz8gtMkNI2n93'
      );
    }

    match /times/{docId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      // Update: Eigentümer (neue Bestzeit) ODER Steward (Neuberechnung nach Streichung)
      allow update: if isAdmin() || (request.auth != null
        && request.resource.data.uid == request.auth.uid);
      // Delete: Steward, oder Eigentümer (z.B. wenn keine gültige Runde mehr übrig)
      allow delete: if isAdmin() || (request.auth != null
        && resource.data.uid == request.auth.uid);

      // Runden-Historie: pro Fahrer/Strecke/Auto die letzten Runden (Zeit + Replay).
      // docId = "<uid>_<trackId>_<carId>" — die uid ist der Teil vor dem ersten "_".
      match /laps/{lapId} {
        allow read: if true;
        allow create: if request.auth != null
          && docId.split('_')[0] == request.auth.uid;
        // struck-Markierung setzt nur der Steward
        allow update: if isAdmin();
        // Aufräumen (Pruning) darf der Fahrer für seine eigenen, Streichen/Löschen der Steward
        allow delete: if isAdmin() || (request.auth != null
          && docId.split('_')[0] == request.auth.uid);
      }
    }

    // Protokoll der Steward-Entscheidungen (Streichungen von Rundenzeiten etc.)
    match /steward_actions/{docId} {
      allow read, create: if isAdmin();
    }

    match /users/{uid} {
      allow read: if true;
      allow write: if (request.auth != null && request.auth.uid == uid) || isAdmin();
    }

    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update: if (request.auth != null
        && resource.data.uid == request.auth.uid) || isAdmin();
    }

    match /steward_msgs/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if isAdmin();
    }

    // Shop: Guthaben/Freischaltungen/Kaufhistorie dürfen NIEMALS vom Client geschrieben
    // werden (sonst könnte sich jeder Spieler selbst unendlich Credits/Autos gutschreiben).
    // Nur die Cloud Functions (createOrder/captureOrder/paypalWebhook in functions/index.js)
    // schreiben hier — die schreiben über das Firebase Admin SDK, das diese Regeln umgeht.
    match /wallets/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /entitlements/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /purchases/{orderId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

  }
}
