{
  "name": "gridline",
  "version": "1.0.0",
  "description": "Gridline Racing Game",
  "main": "main.js",
  "scripts": {
    "start": "node tools/run-electron.cjs",
    "desktop": "node tools/run-electron.cjs",
    "build:dir": "electron-builder --dir",
    "build:dir:unsigned": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:all": "electron-builder --mac --win",
    "test": "npm run audit:gt3 && npm run test:native",
    "audit:gt3": "node tools/gt3-preflight-audit.mjs",
    "test:native": "node tools/validate-native-project.mjs",
    "test:ai": "node tools/ai-drive-audit.cjs",
    "load:local": "node tools/safe-load-test.mjs --base http://127.0.0.1:8787"
  },
  "build": {
    "appId": "com.racing.gridline",
    "productName": "Gridline",
    "files": [
      "main.js",
      "preload.js",
      "gt3-web-racer.html",
      "index.html",
      "datenschutz.html",
      "impressum.html",
      "agb.html",
      "support.html",
      "jugendschutz.html",
      "assets/**/*"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.games"
    },
    "win": {
      "target": "nsis"
    }
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "electron": "^44.3.0",
    "electron-builder": "^24.0.0",
    "meshoptimizer": "^1.2.0",
    "sharp": "^0.35.2"
  }
}
