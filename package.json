{
  "name": "gridline",
  "version": "1.0.0",
  "description": "Gridline Racing Game",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:all": "electron-builder --mac --win",
    "test": "npm run audit:gt3",
    "audit:gt3": "node tools/gt3-preflight-audit.mjs",
    "test:ai": "node tools/ai-drive-audit.cjs"
  },
  "build": {
    "appId": "com.racing.gridline",
    "productName": "Gridline",
    "files": [
      "main.js",
      "gt3-web-racer.html",
      "assets/**/*"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.games"
    },
    "win": {
      "target": "nsis"
    }
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "electron": "^44.3.0",
    "electron-builder": "^24.0.0",
    "meshoptimizer": "^1.2.0",
    "sharp": "^0.35.2"
  }
}
